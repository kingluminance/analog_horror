; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="analog_horror_project"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
StoryFlags="*res://data/story_flags.gd"
Inventory="*res://data/inventory.gd"
Stats="*res://data/stats.gd"
SaveSystem="*res://data/save_system.gd"

[dialogue_manager]

runtime/balloon_path="res://entities/dialogue_ui/analog_dialogue_balloon.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://entities/floating_photo/photos/john.dialogue", "res://entities/floating_photo/photos/ping_pong_bottle.dialogue", "res://entities/orbiting_paddle/paddle.dialogue", "res://entities/red_bouncy_ball/ball.dialogue", "res://entities/trash_angel/trash_angel.dialogue", "res://entities/floating_photo/photos/brain_in_vat.dialogue", "res://entities/floating_photo/photos/speaker.dialogue", "res://entities/speaker/gramophone.dialogue", "res://entities/log_cabin/cabin_door.dialogue", "res://entities/ellikonti/ellikonti.dialogue", "res://entities/bottari_merchant/bottari_merchant.dialogue", "res://entities/bottari_merchant/bottari_merchant_chat.dialogue", "res://entities/bottari_merchant/dialogue/eye_charm_confirm.dialogue", "res://entities/bottari_merchant/dialogue/locked_padlock_confirm.dialogue", "res://entities/bottari_merchant/dialogue/loose_key_confirm.dialogue", "res://entities/floating_photo/photos/scissor_scarf.dialogue", "res://.claude/worktrees/global-skill-addition-15d907/entities/floating_photo/photos/john.dialogue", "res://.claude/worktrees/global-skill-addition-15d907/entities/floating_photo/photos/ping_pong_bottle.dialogue", "res://.claude/worktrees/global-skill-addition-15d907/entities/orbiting_paddle/paddle.dialogue", "res://.claude/worktrees/obsidian-analog-horror-setup-c380df/entities/floating_photo/photos/john.dialogue", "res://.claude/worktrees/obsidian-analog-horror-setup-c380df/entities/floating_photo/photos/ping_pong_bottle.dialogue", "res://.claude/worktrees/obsidian-analog-horror-setup-c380df/entities/orbiting_paddle/paddle.dialogue", "res://.claude/worktrees/godot-github-obsidian-access-a89c6d/entities/bottari_merchant/bottari_merchant.dialogue", "res://.claude/worktrees/godot-github-obsidian-access-a89c6d/entities/bottari_merchant/bottari_merchant_chat.dialogue", "res://.claude/worktrees/godot-github-obsidian-access-a89c6d/entities/bottari_merchant/dialogue/eye_charm_confirm.dialogue", "res://.clau