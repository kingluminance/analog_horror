; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="analog_horror_project"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
StoryFlags="*res://data/story_flags.gd"
Inventory="*res://data/inventory.gd"

[dialogue_manager]

runtime/balloon_path="res://entities/dialogue_ui/analog_dialogue_balloon.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://entities/floating_photo/photos/john.dialogue", "res://entities/floating_photo/photos/ping_pong_bottle.dialogue", "res://entities/orbiting_paddle/paddle.dialogue", "res://entities/floating_photo/photos/brain_in_vat.dialogue", "res://.claude/worktrees/obsidian-analog-horror-setup-c380df/entities/floating_photo/photos/john.dialogue", "res://.claude/worktrees/obsidian-analog-horror-setup-c380df/entities/floating_photo/photos/ping_pong_bottle.dialogue", "res://.claude/worktrees/obsidian-analog-horror-setup-c380df/entities/orbiting_paddle/paddle.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
